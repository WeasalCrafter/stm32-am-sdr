	(text "C = 1/(n * pi * f_receiver_bandwidth * R) = ~50nF\n\n\nWhere n is the number of capacitors being charged, 4 in our case\n\nR is the impedence (50 ohms)\n\nf_receiver_bandwidth is the target bandwidth (32kHz)"
		(exclude_from_sim no)
		(at 248.92 175.514 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "05682a4a-9530-4f06-a955-df88946b9ac5")
	)
	(text "32kHz comes from the fact that AM signals are\nat 10kHz channel widths, so 32kHz fits \ncomfortably in the margin of applying an even\nfilter on it."
		(exclude_from_sim no)
		(at 308.356 171.958 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "150a82be-1bf6-43e2-be94-38bd651aaa7c")
	)
	(text "Have channels A and B always\nactive by pulling low"
		(exclude_from_sim no)
		(at 120.904 194.056 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "31fd89e7-041c-480f-9d60-c88d28052111")
	)
	(text "Both RF and ~RF are biased to 1.65V DC and\nare the raw rf waveforms after the LPF\n\nThe only difference is that ~RF is inverted\n\nThe purpose of this is to minimize loss\nby implementing a double-balanced \nTayloe Detector."
		(exclude_from_sim no)
		(at 262.89 65.786 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "44cbc73a-741f-4f67-b30d-aa18f63c2758")
	)
	(text "Decoupling Caps"
		(exclude_from_sim no)
		(at 166.37 186.182 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5cd690c3-aa39-4224-a5ec-e3c6976814df")
	)
	(text "PI3B3253QEX-2017 dual channel 1:4 multiplexer"
		(exclude_from_sim no)
		(at 121.158 189.738 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "70462161-74ed-4a6f-8af9-93b139088c66")
	)
	(text "\"magnitude response of a first-order (RC) lowpass filter\"\n\n|H(f)| = 1/sqrt(1 + (f/f_bandwidth)^2)\n\n|H(f)| tells us the proportion of the signal\nallowed through at a certain frequency depending\non the set bandwidth of the filter"
		(exclude_from_sim no)
		(at 246.634 201.168 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7704c31e-24c8-49cb-82a6-70f01f614c36")
	)
	(text "DC Blocker"
		(exclude_from_sim no)
		(at 197.104 75.438 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7e90106e-4159-467a-967a-13395899f951")
	)
	(text "Selectable BPF\nSee Other Sheet"
		(exclude_from_sim no)
		(at 177.292 81.026 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9510f498-0b44-4e1d-bb8d-49c44750710c")
	)
	(text "Center Tapped Transformer\n1:4 Impedence Ratio\n\nFor double balanced detector"
		(exclude_from_sim no)
		(at 229.87 81.026 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a1cb4391-d9e8-4cd5-8908-07fa57e58bba")
	)
	(text "Each channel outputs phases that\nare 180 from their match on the\nopposing channel"
		(exclude_from_sim no)
		(at 162.814 149.606 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a6a13659-3e71-410f-af60-cdbd86deb44f")
	)
	(text "RF being the raw signal, \n~RF being the reflected \nsignal from the center tapped transformer"
		(exclude_from_sim no)
		(at 120.65 121.412 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "beef4dbc-1aa9-4a8f-a6be-a3079f0b10e4")
	)
