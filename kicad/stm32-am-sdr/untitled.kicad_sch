	(text "C = 1/(n * pi * f_receiver_bandwidth * R) = ~100nF\n\n\nWhere n is the number of capacitors being charged, 4 in our case\n\nR is the impedence (50 ohms)\n\nf_receiver_bandwidth is the target bandwidth (32kHz)"
		(exclude_from_sim no)
		(at 311.15 148.844 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "05682a4a-9530-4f06-a955-df88946b9ac5")
	)
	(text "32kHz comes from the fact that AM signals are\nat 10kHz channel widths, so 32kHz fits \ncomfortably in the margin of applying an even\nfilter on it."
		(exclude_from_sim no)
		(at 370.586 145.288 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "150a82be-1bf6-43e2-be94-38bd651aaa7c")
	)
	(text "0.5MHz - 1.8MHz 5th Order Butterworth BPF"
		(exclude_from_sim no)
		(at 134.62 228.346 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2c2a0f6c-f4bc-4a69-be3b-05eabed82ae7")
	)
	(text "4.2MHz - 10.5MHz 5th Order Butterworth BPF"
		(exclude_from_sim no)
		(at 241.3 228.346 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2d473c2d-effd-47ed-8040-5c537a5318cd")
	)
	(text "Have channels A and B always\nactive by pulling low"
