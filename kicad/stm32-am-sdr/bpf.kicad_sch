	(text "The MUX has an input capacitance of 36pF \nwhen a switch is on, so subtract that \nfrom the last capacitor in each BPF\n\nOnly matters for low value capacitors who would be affected by this:\nC57 (300) -> (264)\nC58 (100) -> (64)"
		(exclude_from_sim no)
		(at 219.964 49.276 0)
